# GEMINI_API_KEY: Required for Gemini AI API calls (translation, QA reasoning,
# TTS, and audio transcription). Also required for the Benchmark tab: it's
# used both to synthesize the reference audio being evaluated and to run the
# real Gemini ASR provider identity.
GEMINI_API_KEY=gemini_api_key

# SAHARA_API_KEY: powers both the Sahara option in the Voice Generator
# (text-to-speech, /api/tts/generate) and the Sahara speech-to-text provider
# in the Benchmark tab's real ASR evaluation — one key for both.
SAHARA_API_KEY=sahara_api_key
# MODEL_B_API_KEY / MODEL_B_API_URL: Optional secondary real ASR provider for
# the benchmark. Bring your own endpoint — set BOTH the key and the URL to a
# service that accepts POST { audio: base64Wav, mimeType, language } and
# returns { transcript }. Leaving either unset means Model B is honestly
# reported as "not configured" rather than simulated.
# MODEL_C_API_KEY / MODEL_C_API_URL: Optional tertiary real ASR provider for
# the benchmark. Same bring-your-own-endpoint contract as Model B above.
# APP_URL: The URL where this applet is hosted
APP_URL=https:https://sabiline.onrender.com/

# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER: all three are
# required to place the post-intake appointment reminder call. Leaving any
# of them unset means the reminder-call button on the front desk queue
# honestly reports "not configured" rather than pretending a call went out.
# The reminder is always spoken in English via Twilio's built-in <Say> voice,
# regardless of which language the intake itself was conducted in.
TWILO_ACCOUNT_SID=twilo_account_sid
TWILO_AUTH_TOKEN=twilo_auth_token
TWILO_FROM_NUMBER=twilo_from_number

