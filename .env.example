# Copy this file to .env and fill in real values for local development.
# NEVER commit the real .env file — it is gitignored on purpose.

# --- OpenAI-compatible chat/transcription/TTS provider ---
# Primary key. SOPENAI_APIKEY / TOPENAI_APIKEY / FOPENAI_APIKEY are optional
# backups tried in order when the primary is rate-limited, out of quota, or
# rejected as invalid. All keys below are tried against the SAME
# OPENAI_BASE_URL — see the note there before mixing keys from more than one
# provider.
OPEN_AI_KEY=your-openai-api-key-here
# OPENAI_API_KEY=
# SOPENAI_APIKEY=
# TOPENAI_APIKEY=
# FOPENAI_APIKEY=

# Groq key (Groq exposes an OpenAI-compatible chat API — see
# OPENAI_BASE_URL and OPENAI_CHAT_MODEL below, both of which need to be set
# for a Groq origin). Tried after the OpenAI-named keys above.
# GROQ_APIKEY=
# GROKK_APIKEY / GROK_APIKEY / GROOK_APIKEY also still work (earlier
# misspellings of the above, kept for backward compatibility) — prefer
# GROQ_APIKEY for anything new.

# Origin for OpenAI-compatible calls. Defaults to the real api.openai.com if
# unset. Set to https://api.groq.com/openai/v1 to use Groq's keys above
# instead — every key in the list is tried against this ONE origin, so an
# OpenAI key won't work once this points at Groq, and vice versa. For any
# other self-hosted/proxy server, it must genuinely implement the OpenAI
# chat/transcription/speech API, not just happen to be reachable.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model names are provider-specific — e.g. Groq doesn't recognize "gpt-4o-mini".
# These are OPTIONAL. If a configured model is missing or has been retired,
# the server asks the provider what it does serve (GET /v1/models), picks a
# suitable one, and carries on — so a deprecation does not take the app down.
# Set these only to pin a specific model; /api/providers/status always reports
# which model is really in use and whether it was auto-selected.
# (This is not hypothetical: Groq decommissioned llama-3.3-70b-versatile on
# 2026-08-16, which broke every intake turn until the substitution existed.)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_SPEECH_MODEL=tts-1

# Optional: skip endpoint auto-discovery entirely by pointing directly at the
# known-correct route on your OPENAI_BASE_URL (useful for a non-standard
# self-hosted proxy).
# OPENAI_CHAT_PATH=/v1/chat/completions
# OPENAI_TRANSCRIBE_PATH=/v1/audio/transcriptions
# OPENAI_SPEECH_PATH=/v1/audio/speech

# Base per-call timeout in milliseconds. Chat completions use this value;
# transcription (audio upload + processing) gets 1.5x this value. Keep both
# comfortably under your deployment platform's function duration limit.
# OPENAI_CALL_TIMEOUT_MS=20000

# --- Intron Sahara (native African-language TTS + benchmark STT) ---
# The only provider here with real Hausa/Igbo/Yoruba voices. Get a key from
# voice.intron.io -> Developers tab. This key alone enables TTS.
# SAHARA_API_KEY=

# How long to wait for Sahara to finish speaking a reply before falling back to
# another voice. This bounds the WHOLE operation: Sahara caps the text of one
# request, so a long reply is synthesized in pieces and stitched together, and
# a request that overruns Sahara's own 120s window is polled out via its status
# endpoint. Keep it under your platform's function duration limit (vercel.json
# allows 60s).
# SAHARA_TTS_TIMEOUT_MS=25000

# Sahara speech-to-text endpoint. Intron does not publish an ASR route, so this
# is bring-your-own, exactly like MODEL_B/MODEL_C below: point it at a real
# endpoint accepting POST { audio, mimeType, language } -> { transcript }.
# Until it is set, Sahara STT is honestly reported as not configured and
# excluded from benchmark averages — the key alone does NOT enable it.
# SAHARA_ASR_URL=

# --- Custom benchmark ASR endpoints (optional, bring-your-own) ---
# MODEL_B_API_KEY=
# MODEL_B_API_URL=
# MODEL_C_API_KEY=
# MODEL_C_API_URL=

# --- Staff visit notifications (generic Slack/Teams/Discord-compatible webhook) ---
# STAFF_NOTIFY_WEBHOOK_URL=

# --- Twilio (automatic + manual appointment reminder calls) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
