{
  "name": "afrivoice-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vue-tsc -b && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:api",
    "build:api": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node dist/server.cjs",
    "lint": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:mobile": "vue-tsc -b && vite build && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.1.14",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "vite": "^6.2.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
